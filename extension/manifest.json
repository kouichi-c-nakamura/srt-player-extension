{
  "manifest_version": 3,
  "name": "Manual Sync SRT Subtitles Player",
  "version": "0.3.1",
"description": "Floating SRT subtitle overlay with an independent, manually-synced timer. Works on whitelisted streaming sites.",
    "icons": {
    "16": "SRT_128.png",
    "48": "SRT_128.png",
    "128": "SRT_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "SRT_128.png",
      "48": "SRT_128.png",
      "128": "SRT_128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "srt-parser.js", "overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
"browser_specific_settings": {
    "gecko": {
      "id": "manual-sync-srt@nakamura-lab",
      "strict_min_version": "109.0",
      "data_collection_permissions": false
    }
  }
}
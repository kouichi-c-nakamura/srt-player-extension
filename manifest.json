{
  "manifest_version": 3,
  "name": "SRT Player (Independent Timer)",
  "version": "0.3.0",
  "description": "Floating SRT subtitle overlay with an independent, manually-synced timer. Only activates on whitelisted sites (configurable via the toolbar icon).",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "srt-parser.js", "overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "srt-player@example-local-dev.invalid",
      "strict_min_version": "109.0"
    }
  }
}
